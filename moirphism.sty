\usepackage{tikz}
\usetikzlibrary{calc}
\usepackage{xparse}
\usepackage{xifthen}

\tikzset{
    wire/.style={rounded corners=3, line width=.5pt}
	, iden/.style={line width=.5pt}
	, dot/.style={draw,fill=black, circle, inner sep=1pt}
	, wdot/.style={draw,fill=white, circle, inner sep=1pt}
	, cdot/.style={draw,fill=#1, circle, inner sep=1pt}
    , box/.style={pos=.5,font=\tiny,draw, rounded corners=3, inner sep=1.5pt}
	, tag/.style={draw, inner sep=1.5pt}
	, wtag/.style={fill=white,tag, font=\tiny}
  , baseline=(current bounding box.center)
}

\newlength{\moirphismj}      % current x offset
\newlength{\moirphismh}      % current y offset

\def\moirphismbuf{}

\NewDocumentCommand{\wrapmoirphism}{m O{1}}{%
  % #1 = tikz code authored in real target units, centered at (0,0)
  % #2 = height of this piece (default 1)
  \edef\moirphismbuf{%
    \unexpanded\expandafter{\moirphismbuf}%
    \unexpanded{\begin{scope}[yshift=-(\moirphismh+(#2)/2)]#1\end{scope}\addtolength{\moirphismh}{#2}%}%
  }}%
  \addtolength{\moirphismh}{#2}%
}

\RenewDocumentCommand{\>}{}{%
  \begin{scope}[xshift=(\moirphismj+0.5),
                yshift=\moirphismh]
    \moirphismbuf
  \end{scope}
  \addtolength{\moirphismj}{1cm}
  \setlength{\moirphismh}{0pt}
  \gdef\moirphismbuf{}
}

\NewDocumentCommand{\moirphism}{m}{%
  \setlength{\moirphismj}{0pt}%
  \setlength{\moirphismh}{0pt}%
  \gdef\moirphismbuf{}%
  #1\> % flush trailing column
}

% \o is now purely cosmetic

% ---- primitives, authored in real (unscaled) units ----
\NewDocumentCommand{\mor}{O{}O{}}{%
  \wrapmoirphism{
    \draw[wire] (-0.5,0) -- (0.5,0);
    \draw[fill=#2] (-0.25,-0.25) rectangle (0.25,0.25);
    \node at (0,0) {$#1$};
  }[1cm]}

\NewDocumentCommand{\mul}{m}{%
  \wrapmoirphism{
    \draw[wire] (-0.5,+0.5) arc[start angle=90,end angle=-90,x radius=0.5,y radius=0.5];
    \draw[wire] (0,0) -- (0.5,0);
    \node[cdot=#1] at (0,0) {};
  }[2cm]}

\NewDocumentCommand{\comul}{m}{%
  \wrapmoirphism{
    \draw[wire] (-0.5,0) -- (0,0);
    \draw[wire] (+0.5,+0.5) arc[start angle=90,end angle=270,x radius=0.5,y radius=0.5];
    \node[cdot=#1] at (0,0) {};
  }[2cm]}

\NewDocumentCommand{\swap}{}{%
  \wrapmoirphism{
    \draw[wire] (-0.5,+0.25) -- (-0.25,+0.25) -- (+0.25,-0.25) -- (+0.5,-0.25);
    \draw[wire] (-0.5,-0.25) -- (-0.25,-0.25) -- (+0.25,+0.25) -- (+0.5,+0.25);
  }[1cm]}

\NewDocumentCommand{\ccap}{}{%
  \wrapmoirphism{\draw[wire] (-0.5,+0.5) arc[start angle=90,end angle=-90,x radius=0.5,y radius=0.5];}[2]}
\NewDocumentCommand{\ccup}{}{%
  \wrapmoirphism{\draw[wire] (+0.5,+0.5) arc[start angle=90,end angle=270,x radius=0.5,y radius=0.5];}[2]}
