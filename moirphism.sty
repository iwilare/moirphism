\tikzstyle{box}=[fill=white, draw=black, chamfered rectangle, chamfered rectangle corners={north east}, chamfered rectangle sep=2pt, inner sep=0pt, minimum height=1.4em, minimum width=1.4em, scale=0.7]
\tikzstyle{boxOp}=[fill=white, draw=black, chamfered rectangle, chamfered rectangle corners={north west}, chamfered rectangle sep=2pt, inner sep=0pt, minimum height=1.4em, minimum width=1.4em, scale=0.7]
\tikzstyle{func}=[fill=white, draw=black, shape=rounded rectangle, rounded rectangle left arc=none, minimum height=1.5em, minimum width=1.5em, scale=0.7]
\tikzstyle{funcOp}=[fill=white, draw=black, shape=rounded rectangle, rounded rectangle right arc=none, minimum height=1.5em, minimum width=1.5em, scale=0.7]

\tikzset{
    wire/.style={rounded corners=3, line width=.5pt}
  , wire+/.style={rounded corners=3, line width=.5pt, postaction={decorate}, decoration={markings, mark=at position 0.5 with {\pgftransformxshift{2pt}\arrow{stealth}}}}
  , wire-/.style={rounded corners=3, line width=.5pt, postaction={decorate}, decoration={markings, mark=at position 0.5 with {\pgftransformxshift{-2pt}\arrowreversed{stealth}}}}
	, dot/.style={draw,fill=black, circle, inner sep=1pt}
	, wdot/.style={draw,fill=white, circle, inner sep=1pt}
	, cdot/.style={draw,fill=#1, circle, inner sep=1pt}
  , baseline=(current bounding box.center)
}

\newlength{\moirphismj}      % current x offset
\newlength{\moirphismh}      % total y offset
\newlength{\moirphismwip}    % current y offset

\def\moirphismbuf{}

\NewDocumentCommand{\wrapmoirphism}{m O{1cm}}{%
  % #1 = tikz code authored in real target units, centered at (0,0)
  % #2 = height of this piece (default 1)
  \edef\moirphismbuf{%
    \unexpanded\expandafter{\moirphismbuf}%
    \unexpanded{\begin{scope}[yshift=-(\moirphismwip+(#2)/2)]#1\end{scope}\addtolength{\moirphismwip}{#2}%}%
  }}%
  \addtolength{\moirphismh}{#2}%
}

\RenewDocumentCommand{\>}{}{%
  \setlength{\moirphismwip}{0cm}
  \begin{scope}[xshift=(\moirphismj+0.5cm),
                yshift=\moirphismh/2]
    \moirphismbuf
  \end{scope}
  \addtolength{\moirphismj}{1cm}
  \setlength{\moirphismh}{0cm}
  \gdef\moirphismbuf{}
}

\NewDocumentCommand{\moirphism}{m}{%
  \setlength{\moirphismj}{0cm}%
  \setlength{\moirphismh}{0cm}%
  \gdef\moirphismbuf{}%
  #1\> % flush trailing column
}

% ---- primitives, authored in real (unscaled) units ----
\NewDocumentCommand{\mor}{O{}O{}}{%
  \wrapmoirphism{
    \draw[wire] (-0.5,0) -- (0.5,0);
    \node[box] at (0,0) {$#1$};
  }[1cm]}

\NewDocumentCommand{\mul}{m}{%
  \wrapmoirphism{
    \draw[wire] (-0.5,+0.5) arc[start angle=90,end angle=-90,x radius=0.5,y radius=0.5];
    \draw[wire] (0,0) -- (0.5,0);
    \node[cdot=#1] at (0,0) {};
  }[2cm]}

\NewDocumentCommand{\comul}{m}{%
  \wrapmoirphism{
    \draw[wire] (-0.5,0) -- (0,0);
    \draw[wire] (+0.5,+0.5) arc[start angle=90,end angle=270,x radius=0.5,y radius=0.5];
    \node[cdot=#1] at (0,0) {};
  }[2cm]}

\NewDocumentCommand{\swap}{}{%
  \wrapmoirphism{
    \draw[wire] (-0.5,+0.25) -- (-0.25,+0.25) -- (+0.25,-0.25) -- (+0.5,-0.25);
    \draw[wire] (-0.5,-0.25) -- (-0.25,-0.25) -- (+0.25,+0.25) -- (+0.5,+0.25);
  }[1cm]}

\NewDocumentCommand{\ccap}{}{\wrapmoirphism{\draw[wire] (-0.5,+0.5) arc[start angle=90,end angle=-90,x radius=0.5,y radius=0.5];}[2cm]}
\NewDocumentCommand{\ccup}{}{\wrapmoirphism{\draw[wire] (+0.5,+0.5) arc[start angle=90,end angle=270,x radius=0.5,y radius=0.5];}[2cm]}

\NewDocumentCommand{\ccapp}{}{\wrapmoirphism{\draw[wire+] (-0.5,+0.5) arc[start angle=90,end angle=-90,x radius=0.5,y radius=0.5];}[2cm] }
\NewDocumentCommand{\ccapn}{}{\wrapmoirphism{\draw[wire-] (-0.5,+0.5) arc[start angle=90,end angle=-90,x radius=0.5,y radius=0.5];}[2cm] }

\NewDocumentCommand{\ccupp}{}{\wrapmoirphism{\draw[wire+] (+0.5,+0.5) arc[start angle=90,end angle=270,x radius=0.5,y radius=0.5];}[2cm] }
\NewDocumentCommand{\ccupn}{}{\wrapmoirphism{\draw[wire-] (+0.5,+0.5) arc[start angle=90,end angle=270,x radius=0.5,y radius=0.5];}[2cm] }

