\newlength{\moirphismj}      % current x offset
\newlength{\moirphismh}      % total y offset (height) of current column
\newlength{\moirphismwip}    % current y offset while building a column
\newlength{\moirphismmaxw}   % max width of current column
\newlength{\moirphismW}      % half-width of the element currently being drawn

\def\moirphismbuf{}

% #1 code (may use \moirphismW as its own half-width instead of a literal 0.5)
% #2 height (default 1cm)
% #3 width, a bare number (default 1)
% #4 number of wires entering at the left edge (default 1)
% #5 number of wires leaving at the right edge (default 1)
\NewDocumentCommand{\wrapmoirphism}{m O{1cm} O{1} O{1} O{1}}{%
  \edef\moirphismbuf{%
    \unexpanded\expandafter{\moirphismbuf}%
    \unexpanded{%
      \begin{scope}[yshift=-(\moirphismwip+(#2)/2)]%
        \setlength{\moirphismW}{\dimexpr #3/2\relax}%
        \ifdim 2\moirphismW<\moirphismmaxw \moirphismextend{#4}{#5}\fi
        #1%
      \end{scope}\addtolength{\moirphismwip}{#2}%
    }%
  }%
  \addtolength{\moirphismh}{#2}%
  \ifdim #3>\moirphismmaxw \setlength{\moirphismmaxw}{#3}\fi
}

% draws, behind everything else, the wire stubs joining a narrower box's
% edges out to the column's actual (wider) edge
\newcommand{\moirphismextend}[2]{%
  \ifnum#1>0
    \foreach \i in {1,...,#1}{
      \pgfmathsetmacro{\yy}{(#1-1)/2-(\i-1)}
      \draw[wire] (-\moirphismmaxw/2,\yy) -- (-\moirphismW,\yy);
    }
  \fi
  \ifnum#2>0
    \foreach \i in {1,...,#2}{
      \pgfmathsetmacro{\yy}{(#2-1)/2-(\i-1)}
      \draw[wire] (\moirphismW,\yy) -- (\moirphismmaxw/2,\yy);
    }
  \fi
}

\RenewDocumentCommand{\>}{}{%
  \setlength{\moirphismwip}{0cm}
  \begin{scope}[xshift=(\moirphismj+\moirphismmaxw/2),
                yshift=\moirphismh/2]
    \moirphismbuf
  \end{scope}
  \addtolength{\moirphismj}{\moirphismmaxw}
  \setlength{\moirphismh}{0cm}
  \setlength{\moirphismmaxw}{0cm}
  \gdef\moirphismbuf{}
}

\NewDocumentCommand{\moirphism}{m}{%
  \setlength{\moirphismj}{0cm}%
  \setlength{\moirphismh}{0cm}%
  \setlength{\moirphismmaxw}{0cm}%
  \gdef\moirphismbuf{}%
  #1\> % flush trailing column
}

