\NewDocumentCommand{\mor}{m O{0.58cm}}{%
  \wrapmoirphism{
    \draw[wire] (-\moirphismW,0) -- (\moirphismW,0);
    \node[box] at (0,0) {$#1$};
  }[1cm][#2]}

