  , wire+/.style={rounded corners=3, postaction={decorate}, decoration={markings, mark=at position 0.5 with {\pgftransformxshift{2pt}\arrow{stealth}}}}
  , wire-/.style={rounded corners=3, postaction={decorate}, decoration={markings, mark=at position 0.5 with {\pgftransformxshift{-2pt}\arrowreversed{stealth}}}}
	, wire+end/.style={rounded corners=3, postaction={decorate}, decoration={markings, mark=at position 0.93 with {\pgftransformxshift{2pt}\arrow{stealth}}}}
  , wire-end/.style={rounded corners=3, postaction={decorate}, decoration={markings, mark=at position 0.93 with {\pgftransformxshift{-2pt}\arrowreversed{stealth}}}}
