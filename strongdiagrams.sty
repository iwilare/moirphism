\NewDocumentCommand{\MProjDP}{}{{\MWiredNode{white}[ ][+]}}
\NewDocumentCommand{\MProjDN}{}{{\MWiredNode{white}[ ][-]}}
\NewDocumentCommand{\MProjPD}{}{{\MWiredNode{white}[+][ ]}}
\NewDocumentCommand{\MProjND}{}{{\MWiredNode{white}[-][ ]}}







\newcommand{\sidebyside}[2]{%
  \hbox{%
    \llap{#2}%
    #1%
  }%
}

\newcommand{\tensor}[2]{%
  \setbox0=\hbox{#1}%
  \setbox1=\hbox{#2}%
  \dimen2=\dp0
  \advance\dimen2 by \ht1
  \divide\dimen2 by 2
  \raisebox{-\dimen2}{%
    \vbox{\offinterlineskip\box0\box1}%
  }%
}

\RenewDocumentCommand{\>}{}{%
\hspace{-0.01mm}%
}

\newcommand{\seq}[1]{%
  \hbox{#1}%
}
