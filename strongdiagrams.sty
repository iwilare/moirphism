\newcommand{\MPar}[2]{%
  \setbox0=\hbox{#1}%
  \setbox1=\hbox{#2}%
  \dimen2=\dp0
  \advance\dimen2 by \ht1
  \divide\dimen2 by 2
  \raisebox{-\dimen2}{%
    \vbox{\offinterlineskip\box0\box1}%
  }%
}

\newcommand{\MSeq}[2]{%
  \hbadness=10000%
  \setbox0=\hbox{#1}%
  \setbox1=\hbox{#2}%
  \hbox to \dimexpr\wd0+\wd1\relax{%
    \hbox to 0pt{\kern\wd0 \box1\hss}%
    \box0
  }%
}

\RenewDocumentCommand{\>}{}{%
\hspace{-0.01mm}%
}

%%%%%%%%%%%%%%%%%% WIRES AND EMPTY %%%%%%%%%%%%%%%%%%%%

\NewDocumentCommand{\MWire}{O{}}{%
    \begin{tikzpicture}[baseline={(0,0)}]
        \draw[wire#1] (-0.5,0) -- (0.5,0);
        \pgfresetboundingbox
        \path (-0.5,0) rectangle (0.5,0);
    \end{tikzpicture}%
}
\NewDocumentCommand{\MEmpty}{}{%
    \begin{tikzpicture}[baseline={(0,0)}]
        \pgfresetboundingbox
        \path (-0.5,0) rectangle (0.5,0);
    \end{tikzpicture}%
}

\NewDocumentCommand{\MHalfWire}{O{}}{%
    \begin{tikzpicture}[baseline={(0,0)}]
        \draw[wire#1] (-0.25,0) -- (0.25,0);
        \pgfresetboundingbox
        \path (-0.25,0) rectangle (0.25,0);
    \end{tikzpicture}%
}
\NewDocumentCommand{\MHalfEmpty}{}{%
    \begin{tikzpicture}[baseline={(0,0)}]
        \pgfresetboundingbox
        \path (-0.25,0) rectangle (0.25,0);
    \end{tikzpicture}%
}

%%%%%%%%%%%%%%%%%% ATOMS AND BOXES %%%%%%%%%%%%%%%%%%%%

% Template function for nodes
\NewDocumentCommand{\MNode}{m}{%
    \begin{tikzpicture}[baseline={(0,0)}]
        \node[#1] at (0,0) {};
        \pgfresetboundingbox
        \path (0,-0.5) rectangle (0,0.5);
    \end{tikzpicture}%
}

% Use this to 1. add left and right wires, 2. anchor the wires to the node
\NewDocumentCommand{\MWiredNode}{m O{} O{}}{%
    \begin{tikzpicture}[baseline={(0,0)}]
        \node[#1] (a) at (0,0) {};
        \draw[wire#2] (-0.5,0) -- (a.west);
        \draw[wire#3] (a.east) -- (0.5,0);
        \pgfresetboundingbox
        \path (-0.5,-0.5) rectangle (0.5,0.5);
    \end{tikzpicture}%
}

% This is the same as WiredNode but the wires attach to the center
\NewDocumentCommand{\MWiredNodeSingularity}{m O{} O{}}{%
    \begin{tikzpicture}[baseline={(0,0)}]
        \draw[wire#2] (-0.5,0) -- (0,0);
        \draw[wire#3] (0,0) -- (0.5,0);
        \node[#1] (a) at (0,0) {};
        \pgfresetboundingbox
        \path (-0.5,-0.5) rectangle (0.5,0.5);
    \end{tikzpicture}%
}

\NewDocumentCommand{\MTyp}{m O{0.5}}{%
\begin{tikzpicture}[baseline={(0,0)}]
    \node at (0,0) {$#1$};
    \pgfresetboundingbox
    \path (-#2,-0.5) rectangle (#2,0.5);
\end{tikzpicture}%
}

\NewDocumentCommand{\MTypTwo}{m m}{\MPar{\MTyp{#1}}{\MTyp{#2}}}


%%%%%%%%%%%%%%%%%%%% COMPACT CLOSED %%%%%%%%%%%%%%%%%%

\NewDocumentCommand{\MCupSemicircle}{O{}O{}}{%
    \begin{tikzpicture}[baseline={(0,0)}]
        \draw[wire#1] (0,0) arc[start angle=180,end angle=90,x radius=0.5,y radius=0.5];
        \draw[wire#2] (0,0) arc[start angle=180,end angle=270,x radius=0.5,y radius=0.5];
        \pgfresetboundingbox
        \path (0,-1) rectangle (0.5,1);
    \end{tikzpicture}%
}

\NewDocumentCommand{\MCapSemicircle}{O{}O{}}{%
    \begin{tikzpicture}[baseline={(0,0)}]
        \draw[wire#2] (0,0.5) arc[start angle=90,end angle=0,x radius=0.5,y radius=0.5];
        \draw[wire#1] (0,-0.5) arc[start angle=-90,end angle=0,x radius=0.5,y radius=0.5];
        \pgfresetboundingbox
        \path (0,-1) rectangle (0.5,1);
    \end{tikzpicture}%
}

\NewDocumentCommand{\MCup}{O{}O{}}{%
    \begin{tikzpicture}[baseline={(0,0)}]
        \draw[wire#1] (+0.5,+0.5) arc[start angle=90,end angle=270,x radius=0.5,y radius=0.5];
        \pgfresetboundingbox
        \path (0,-0.5) rectangle (0.5,0.5);
    \end{tikzpicture}%
}

\NewDocumentCommand{\MCap}{O{}O{}}{%
    \begin{tikzpicture}[baseline={(0,0)}]
        \draw[wire#1] (0,+0.5) arc[start angle=90,end angle=-90,x radius=0.5,y radius=0.5];
        \pgfresetboundingbox
        \path (0,-0.5) rectangle (0.5,0.5);
    \end{tikzpicture}%
}

\NewDocumentCommand{\MSwap}{O{}O{}}{%
    \begin{tikzpicture}[baseline={(0,0)}]
        \draw[wire#1] (-0.5,+0.5) .. controls (0,+0.5) and (0,-0.5) .. (+0.5,-0.5);
        \draw[wire#2] (-0.5,-0.5) .. controls (0,-0.5) and (0,+0.5) .. (+0.5,+0.5);
        \pgfresetboundingbox
        \path (-0.5,-0.5) rectangle (0.5,0.5);
    \end{tikzpicture}%
}

%%%%%%%%%%%%%%%%%%%% (CO)MONOID %%%%%%%%%%%%%%%%%%

\NewDocumentCommand{\MCopier}{O{}}{%
\MHalfWire[#1]\MNode{black}\MCupSemicircle[#1][#1]%
}
\NewDocumentCommand{\MCopierNoWire}{O{}}{%
\MNode{black}\MCupSemicircle[#1][#1]%
}

\NewDocumentCommand{\MCocopier}{O{}}{%
\MCapSemicircle[#1][#1]\MNode{black}\MHalfWire[#1]%
}

\NewDocumentCommand{\MCocopierNoWire}{O{}}{%
\MCapSemicircle[#1][#1]\MNode{black}%
}

\NewDocumentCommand{\MDiscard}{O{}}{%
\MHalfWire[#1]\MNode{black}\MHalfEmpty%
}
\NewDocumentCommand{\MDiscardNoWire}{O{}}{%
\MNode{black}\MHalfEmpty%
}

\NewDocumentCommand{\MCodiscard}{O{}}{%
\MHalfEmpty\MNode{black}\MHalfWire[#1]%
}
\NewDocumentCommand{\MCodiscardNoWire}{O{}}{%
\MHalfEmpty\MNode{black}%
}

