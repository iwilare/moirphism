%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\NewDocumentCommand{\MWire}{O{}}{%
    \begin{tikzpicture}[baseline={(0,0)}]
        \draw[wire#1] (-0.5,0) -- (0.5,0);
        \pgfresetboundingbox
        \path (-0.5,0) rectangle (0.5,0);
    \end{tikzpicture}%
}
\NewDocumentCommand{\MEmpty}{}{%
    \begin{tikzpicture}[baseline={(0,0)}]
        \pgfresetboundingbox
        \path (-0.5,0) rectangle (0.5,0);
    \end{tikzpicture}%
}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\NewDocumentCommand{\MHalfWire}{O{}}{%
    \begin{tikzpicture}[baseline={(0,0)}]
        \draw[wire#1] (-0.25,0) -- (0.25,0);
        \pgfresetboundingbox
        \path (-0.25,0) rectangle (0.25,0);
    \end{tikzpicture}%
}
\NewDocumentCommand{\MHalfEmpty}{}{%
    \begin{tikzpicture}[baseline={(0,0)}]
        \pgfresetboundingbox
        \path (-0.25,0) rectangle (0.25,0);
    \end{tikzpicture}%
}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

% Template function for nodes
\NewDocumentCommand{\MNode}{m}{%
    \begin{tikzpicture}[baseline={(0,0)}]
        \node[#1] at (0,0) {};
        \pgfresetboundingbox
        \path (0,0) rectangle (0,0);
    \end{tikzpicture}%
}

\NewDocumentCommand{\MWiredNode}{m O{} O{}}{%
    \begin{tikzpicture}[baseline={(0,0)}]
        \node[#1] (a) at (0,0) {};
        \draw[wire#2] (-0.5,0) -- (a.west);
        \draw[wire#3] (a.east) -- (0.5,0);
        \pgfresetboundingbox
        \path (-0.5,-0.5) rectangle (0.5,0.5);
    \end{tikzpicture}%
}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\NewDocumentCommand{\MSemicircle}{O{}O{}}{%
    \begin{tikzpicture}[baseline={(0,0)}]
        \draw[wire#1] (0,0) arc[start angle=180,end angle=90,x radius=0.5,y radius=0.5];
        \draw[wire#2] (0,0) arc[start angle=180,end angle=270,x radius=0.5,y radius=0.5];
        \pgfresetboundingbox
        \path (0,-1) rectangle (0.5,1);
    \end{tikzpicture}%
}

\NewDocumentCommand{\MCup}{O{}O{}}{%
    \begin{tikzpicture}[baseline={(0,0)}]
        \draw[wire#1] (+0.5,+0.5) arc[start angle=90,end angle=270,x radius=0.5,y radius=0.5];
        \pgfresetboundingbox
        \path (0,-0.5) rectangle (0.5,0.5);
    \end{tikzpicture}%
}
\NewDocumentCommand{\MCap}{O{}O{}}{%
    \begin{tikzpicture}[baseline={(0,0)}]
        \draw[wire#1] (0,+0.5) arc[start angle=90,end angle=-90,x radius=0.5,y radius=0.5];
        \pgfresetboundingbox
        \path (0,-0.5) rectangle (0.5,0.5);
    \end{tikzpicture}%
}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\NewDocumentCommand{\MCopier}{O{}}{%
  \seq{\MHalfWire[#1]\MNode{black}\MSemicircle[#1][#1]}
}

\NewDocumentCommand{\MCopierNoWire}{O{}}{%
  \seq{\MNode{black}\MSemicircle[#1][#1]}
}

